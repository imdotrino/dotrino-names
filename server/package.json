{
  "name": "@dotrino/names-server",
  "version": "0.2.0",
  "description": "El servidor del directorio de nombres de Dotrino (names.dotrino.com).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "dotrino-names": "./server.js"
  },
  "scripts": {
    "start": "node server.js serve",
    "test": "node --test test/*.test.mjs",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@dotrino/identity": "0.135.0",
    "@dotrino/names": "file:..",
    "@dotrino/pay": "0.1.0",
    "@dotrino/remote-agent": "0.32.1",
    "@dotrino/update": "0.12.1",
    "@dotrino/vault": "0.116.0",
    "@dotrino/verifier": "0.3.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
